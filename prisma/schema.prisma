generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id              String                      @id @default(cuid())
  email           String                      @unique
  emailVerified   DateTime?
  passwordHash    String?
  role                  UserRole                    @default(USER)
  status                UserStatus                  @default(ACTIVE)
  credits               Int                         @default(5)
  plan                  PlanTier                    @default(FREE)
  subscriptionStatus    SubscriptionStatus?
  subscriptionExpiresAt DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  deletedAt       DateTime?
  accounts        Account[]
  aiGenerations   AiGeneration[]
  aiPromptLogs    AiPromptLog[]
  creditTxns      CreditTransaction[]
  creditWallet    CreditWallet?
  recommendations DestinationRecommendation[]
  journeys        Journey[]
  notifications   Notification[]
  profile         Profile?
  savedJourneys   SavedJourney[]
  savedPlaces     SavedPlace[]
  sessions        Session[]
  subscriptions   Subscription[]
  activities      UserActivity[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

/// OAuth/credentials provider links (NextAuth shape).
model Account {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  type              String
  refreshToken      String?
  accessToken       String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Server sessions (also reused to back mobile refresh sessions later).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  userAgent    String?
  ipAddress    String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Profile {
  id                    String               @id @default(cuid())
  userId                String               @unique
  firstName             String?
  lastName              String?
  avatarUrl             String?
  bio                   String?
  homeCity              String?
  homeCountry           String?
  locale                String               @default("en")
  timezone              String?
  city                  String?
  state                 String?
  country               String?
  countryCode           String?
  formattedAddress      String?
  latitude              Float?
  longitude             Float?
  locationPlaceId       String?
  locationUpdatedAt     DateTime?
  onboardingCompletedAt DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  interests             ProfileInterest[]
  styles                ProfileTravelStyle[]
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences           TravelPreference?

  @@index([countryCode])
  @@map("profiles")
}

/// Single-row preference config per profile (1:1). Scalar + JSON mix keeps
/// common queries indexable while allowing flexible extension.
model TravelPreference {
  id                   String              @id @default(cuid())
  profileId            String              @unique
  pace                 TravelPace          @default(SLOW_UNHURRIED)
  transport            TransportPreference @default(RAIL_FIRST)
  budget               BudgetTier          @default(COMFORTABLE)
  units                MeasurementSystem   @default(METRIC)
  avoidCrowds          Boolean             @default(true)
  regenerativeOnly     Boolean             @default(false)
  localGuides          Boolean             @default(true)
  smallScale           Boolean             @default(true)
  lowWaste             Boolean             @default(false)
  maxTravelHoursPerDay Int?
  preferredTripLength  Int?
  extras               Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  profile              Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("travel_preferences")
}

/// Catalog of travel styles (seeded). Stable `slug` is the API contract.
model TravelStyle {
  id          String               @id @default(cuid())
  slug        String               @unique
  name        String
  description String?
  glyph       String?
  sortOrder   Int                  @default(0)
  isActive    Boolean              @default(true)
  profiles    ProfileTravelStyle[]

  @@map("travel_styles")
}

/// Catalog of interests (seeded).
model Interest {
  id        String            @id @default(cuid())
  slug      String            @unique
  name      String
  glyph     String?
  sortOrder Int               @default(0)
  isActive  Boolean           @default(true)
  profiles  ProfileInterest[]

  @@map("interests")
}

/// Join: Profile <-> TravelStyle (explicit for future weighting metadata).
model ProfileTravelStyle {
  profileId String
  styleId   String
  weight    Int         @default(1)
  createdAt DateTime    @default(now())
  profile   Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  style     TravelStyle @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([profileId, styleId])
  @@index([styleId])
  @@map("profile_travel_styles")
}

/// Join: Profile <-> Interest.
model ProfileInterest {
  profileId  String
  interestId String
  weight     Int      @default(1)
  createdAt  DateTime @default(now())
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, interestId])
  @@index([interestId])
  @@map("profile_interests")
}

/// Catalog of purchasable plans. Pricing/identifiers reference Stripe so the
/// app never hardcodes money — Stripe remains the source of truth for price.
model MembershipPlan {
  id               String          @id @default(cuid())
  tier             PlanTier
  name             String
  description      String?
  interval         BillingInterval @default(MONTH)
  stripeProductId  String?         @unique
  stripePriceId    String?         @unique
  priceAmount      Int?
  priceCurrency    String          @default("usd")
  monthlyCredits   Int             @default(0)
  unlimitedCredits Boolean         @default(false)
  features         Json?
  isActive         Boolean         @default(true)
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  subscriptions    Subscription[]

  @@index([tier])
  @@map("membership_plans")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  planId               String
  status               SubscriptionStatus @default(INCOMPLETE)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  plan                 MembershipPlan     @relation(fields: [planId], references: [id])
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([stripeCustomerId])
  @@map("subscriptions")
}

/// One wallet per user; running `balance` is a denormalised cache validated by
/// the immutable CreditTransaction ledger.
model CreditWallet {
  id               String              @id @default(cuid())
  userId           String              @unique
  balance          Int                 @default(0)
  lifetimeGranted  Int                 @default(0)
  lifetimeConsumed Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  transactions     CreditTransaction[]
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_wallets")
}

/// Append-only ledger. Never mutate rows; corrections are new ADJUSTMENT rows.
model CreditTransaction {
  id             String                @id @default(cuid())
  walletId       String
  userId         String
  type           CreditTransactionType
  amount         Int
  balanceAfter   Int
  reason         String?
  journeyId      String?
  aiGenerationId String?
  externalRef    String?               @unique
  expiresAt      DateTime?
  createdAt      DateTime              @default(now())
  aiGeneration   AiGeneration?         @relation(fields: [aiGenerationId], references: [id])
  journey        Journey?              @relation(fields: [journeyId], references: [id])
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet         CreditWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([type])
  @@map("credit_transactions")
}

model Journey {
  id             String              @id @default(cuid())
  userId         String
  title          String
  summary        String?
  status         JourneyStatus       @default(DRAFT)
  originQuery    String?
  primaryCountry String?
  region         String?
  pace           TravelPace?
  startDate      DateTime?
  endDate        DateTime?
  durationDays   Int?
  travelerCount  Int                 @default(1)
  budget         BudgetTier?
  heroImageUrl   String?
  metadata       Json?
  boundingBox    Json?
  version        Int                 @default(1)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?
  generations    AiGeneration[]
  creditTxns     CreditTransaction[]
  refinements    JourneyRefinement[]
  stops          JourneyStop[]
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedBy        SavedJourney[]

  @@index([userId, status, updatedAt])
  @@index([userId, status])
  @@index([status])
  @@index([createdAt])
  @@map("journeys")
}

/// An ordered stop within a journey. Carries geo + Google Place reference.
model JourneyStop {
  id            String   @id @default(cuid())
  journeyId     String
  order         Int
  kind          StopKind @default(CITY)
  name          String
  description   String?
  nights        Int?
  dayStart      Int?
  dayEnd        Int?
  googlePlaceId String?
  latitude      Float?
  longitude     Float?
  address       String?
  imageUrl      String?
  highlights    String[]
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  journey       Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([journeyId, order])
  @@index([journeyId])
  @@index([googlePlaceId])
  @@map("journey_stops")
}

/// Each refinement is an immutable record of a change request + its result,
/// preserving the journey's evolution and giving Claude conversational memory.
model JourneyRefinement {
  id             String         @id @default(cuid())
  journeyId      String
  type           RefinementType
  instruction    String?
  params         Json?
  fromVersion    Int?
  toVersion      Int?
  aiGenerationId String?
  createdAt      DateTime       @default(now())
  aiGeneration   AiGeneration?  @relation(fields: [aiGenerationId], references: [id])
  journey        Journey        @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId, createdAt])
  @@map("journey_refinements")
}

/// A place a user bookmarked (destination/stay/experience). Geo-aware.
model SavedPlace {
  id            String         @id @default(cuid())
  userId        String
  kind          SavedPlaceKind @default(DESTINATION)
  name          String
  note          String?
  googlePlaceId String?
  latitude      Float?
  longitude     Float?
  country       String?
  imageUrl      String?
  metadata      Json?
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, googlePlaceId])
  @@index([userId, createdAt])
  @@map("saved_places")
}

/// A user's bookmark of a journey (their own or, later, a shared one).
model SavedJourney {
  id        String   @id @default(cuid())
  userId    String
  journeyId String
  note      String?
  createdAt DateTime @default(now())
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, journeyId])
  @@index([userId, createdAt])
  @@map("saved_journeys")
}

/// AI/editorial destination suggestions surfaced to a user.
model DestinationRecommendation {
  id             String               @id @default(cuid())
  userId         String
  source         RecommendationSource @default(CLAUDE)
  status         RecommendationStatus @default(SUGGESTED)
  title          String
  reason         String?
  region         String?
  country        String?
  googlePlaceId  String?
  latitude       Float?
  longitude      Float?
  imageUrl       String?
  score          Float?
  aiGenerationId String?
  metadata       Json?
  createdAt      DateTime             @default(now())
  expiresAt      DateTime?
  aiGeneration   AiGeneration?        @relation(fields: [aiGenerationId], references: [id])
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, score])
  @@index([userId, status])
  @@index([userId, score])
  @@map("destination_recommendations")
}

/// A single Claude generation request/response. The user-facing, structured
/// record of AI work (cost, status, tokens, output). Raw prompt text lives in
/// AiPromptLog to keep this table lean and queryable.
model AiGeneration {
  id              String                      @id @default(cuid())
  userId          String
  kind            AiGenerationKind
  status          AiGenerationStatus          @default(QUEUED)
  model           String
  temperature     Float?
  maxTokens       Int?
  inputTokens     Int?
  outputTokens    Int?
  costMicroUsd    Int?
  latencyMs       Int?
  output          Json?
  errorMessage    String?
  journeyId       String?
  createdAt       DateTime                    @default(now())
  completedAt     DateTime?
  journey         Journey?                    @relation(fields: [journeyId], references: [id])
  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptLogs      AiPromptLog[]
  creditTxns      CreditTransaction[]
  recommendations DestinationRecommendation[]
  refinements     JourneyRefinement[]

  @@index([userId, createdAt])
  @@index([kind, status])
  @@map("ai_generations")
}

/// Raw prompt/response payloads per message turn. Separated for size, privacy
/// controls, and selective retention/redaction.
model AiPromptLog {
  id           String       @id @default(cuid())
  generationId String
  userId       String
  role         String
  content      Json
  sequence     Int          @default(0)
  toolCalls    Json?
  redactedAt   DateTime?
  createdAt    DateTime     @default(now())
  generation   AiGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([generationId, sequence])
  @@index([userId, createdAt])
  @@map("ai_prompt_logs")
}

/// Append-only behavioural event log (product analytics + personalisation).
model UserActivity {
  id         String       @id @default(cuid())
  userId     String
  type       ActivityType
  targetType String?
  targetId   String?
  metadata   Json?
  platform   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("user_activities")
}

model Notification {
  id          String              @id @default(cuid())
  userId      String
  type        NotificationType
  channel     NotificationChannel @default(IN_APP)
  title       String
  body        String?
  actionUrl   String?
  metadata    Json?
  readAt      DateTime?
  sentAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime            @default(now())
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum UserRole {
  USER
  CURATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
  APPLE
}

/// Single-select travel pace captured during onboarding (Step 4).
enum TravelPace {
  ONE_PLACE_DEEPLY
  SLOW_UNHURRIED
  GENTLY_BALANCED
}

/// Distance/transport bias used when generating routes.
enum TransportPreference {
  RAIL_FIRST
  MIXED
  ROAD
  ANY
}

enum BudgetTier {
  MODEST
  COMFORTABLE
  PREMIUM
  LUXURY
}

enum MeasurementSystem {
  METRIC
  IMPERIAL
}

/// Catalog billing interval for a plan.
enum BillingInterval {
  NONE
  ONE_TIME
  MONTH
  YEAR
}

/// Plan archetypes (kept stable; pricing lives on MembershipPlan rows).
enum PlanTier {
  FREE
  PER_JOURNEY
  PREMIUM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

/// Direction/reason for a credit ledger entry.
enum CreditTransactionType {
  GRANT
  PURCHASE
  PROMO
  CONSUMPTION
  REFUND
  EXPIRATION
  ADJUSTMENT
}

enum JourneyStatus {
  DRAFT
  GENERATING
  READY
  REFINING
  ARCHIVED
  FAILED
}

/// Why a journey was (re)generated — supports analytics + Claude context.
enum RefinementType {
  INITIAL
  PACE_CHANGE
  ADD_INTEREST
  REMOVE_STOP
  ADD_STOP
  REORDER
  DATE_CHANGE
  BUDGET_CHANGE
  AVOID_CROWDS
  FREEFORM
}

enum StopKind {
  CITY
  TOWN
  VILLAGE
  NATURE
  HERITAGE_SITE
  STAY
  EXPERIENCE
  TRANSIT
  MEAL
}

enum SavedPlaceKind {
  DESTINATION
  STAY
  EXPERIENCE
  RESTAURANT
  POINT_OF_INTEREST
}

enum RecommendationSource {
  CLAUDE
  EDITORIAL
  TRENDING
  SIMILAR_TRAVELERS
}

enum RecommendationStatus {
  SUGGESTED
  VIEWED
  SAVED
  DISMISSED
}

/// Lifecycle of a single Claude generation request.
enum AiGenerationStatus {
  QUEUED
  STREAMING
  COMPLETED
  FAILED
  CANCELED
}

/// What a generation was for (keeps prompt strategy organised).
enum AiGenerationKind {
  JOURNEY_PLAN
  JOURNEY_REFINEMENT
  DESTINATION_INSIGHT
  RECOMMENDATION
  SUMMARY
}

enum NotificationType {
  SYSTEM
  JOURNEY_READY
  JOURNEY_FAILED
  RECOMMENDATION
  BILLING
  CREDIT
  ONBOARDING
  MARKETING
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum ActivityType {
  SIGN_UP
  LOGIN
  ONBOARDING_STEP
  ONBOARDING_COMPLETE
  JOURNEY_CREATED
  JOURNEY_REFINED
  JOURNEY_VIEWED
  PLACE_SAVED
  JOURNEY_SAVED
  SUBSCRIPTION_CHANGED
  CREDIT_SPENT
  RECOMMENDATION_CLICKED
}
